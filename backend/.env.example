PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management_system
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
